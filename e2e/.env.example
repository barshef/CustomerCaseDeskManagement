# Copy to e2e/.env (git-ignored) and fill in. Never commit the real file.

# The Dev environment and the CaseDesk model-driven app (Power Apps > Apps > CaseDesk > Details > App ID)
CASEDESK_URL=https://<org>.crm.dynamics.com
CASEDESK_APP_ID=<app module id guid>

# The ExternalStub GET endpoint (chapter 7) and its function key.
# Put the real key in .env only: Azure portal > Function app > ExternalStub > Function keys.
STUB_URL=https://<func>.azurewebsites.net/api/external/caseclosed
STUB_KEY=

# Chapter 3: set to 1 when filming and you will approve the refund by hand in Teams/Outlook.
# APPROVE_BY_HAND=1
# APPROVE_WAIT_MINUTES=10

# Voice-over: NOT set here. The film script reads the PC's user environment variables
# DEMO_SPEECH_KEY and DEMO_SPEECH_REGION (e.g. uksouth), set once with setx.
# Optional: DEMO_VOICE=en-GB-SoniaNeural   DEMO_SPEECH=none (force a silent film)
