  <datadescription>
    <datadefinition>
      <fetchcollection>
        <fetch mapping="logical" aggregate="true">
          <entity name="cd_case">
            <attribute name="cd_caseid" aggregate="count" alias="aggregate_column" />
            <attribute name="ownerid" groupby="true" alias="groupby_column" />
            <filter type="and">
              <condition attribute="cd_duedate" operator="this-week" />
              <filter type="or">
                <filter type="and">
                  <condition attribute="statecode" operator="eq" value="0" />
                  <condition attribute="cd_resolvedon" operator="null" />
                  <condition attribute="cd_duedate" operator="olderthan-x-minutes" value="1" />
                </filter>
                <condition attribute="cd_resolvedon" operator="gt" valueof="cd_duedate" />
              </filter>
            </filter>
          </entity>
        </fetch>
      </fetchcollection>
      <categorycollection>
        <category>
          <measurecollection>
            <measure alias="aggregate_column" />
          </measurecollection>
        </category>
      </categorycollection>
    </datadefinition>
  </datadescription>
